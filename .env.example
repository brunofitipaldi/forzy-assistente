# Copie para .env (ou defina no terminal). Nenhuma variavel e obrigatoria: os valores abaixo sao os padroes.

# Backend de geracao: ollama (local, padrao) ou groq (nuvem)
LLM_BACKEND=ollama
LLM_MODEL=llama3.1
LLM_TEMPERATURA=0.1
LLM_MAX_TOKENS=450

# Endereco do servidor Ollama e modelo de embeddings do RAG
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=embeddinggemma

# Somente se LLM_BACKEND=groq (crie a chave em console.groq.com; NUNCA versione a chave real)
# LLM_MODEL=llama-3.1-8b-instant
# GROQ_API_KEY=<sua_chave_aqui>
